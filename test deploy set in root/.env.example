# docker-compose settings. Copy to .env and change EVERY secret before running
# on a server. Defaults are shown.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=generic_erp
# If the password contains special characters (@ : / # ?), URL-encode it.
PG_POOL_MAX=10

# --- Object storage (RustFS), shared by storage, api and worker ---
S3_ACCESS_KEY=erp-storage
S3_SECRET_KEY=erp-storage-secret
S3_BUCKET=erp-uploads

# --- First admin login (only used when the database has no users yet) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# --- Security ---
# true when the app is served over HTTPS (the session cookie becomes HTTPS-only)
COOKIE_SECURE=false

# --- Operations ---
LOG_LEVEL=info
# set a long random string to enable GET /metrics on the API (Prometheus);
# scrape with "Authorization: Bearer <token>"
METRICS_TOKEN=

# --- Host ports (database/storage/API are bound to 127.0.0.1 only) ---
DB_PORT=5433
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
API_PORT=5000
# the web app is reachable from the network on this port (deploy.sh picks 80 if free)
WEB_PORT=8080

# --- Backups (used by ./deploy.sh backup and the nightly schedule) ---
# point BACKUP_DIR at a NAS or USB disk mount to keep copies off this computer
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# --- Public access from anywhere (optional; set by ./deploy.sh public) ---
# token of a Cloudflare Tunnel whose public hostname points to http://web:80
CLOUDFLARE_TUNNEL_TOKEN=
# "tunnel" = Cloudflare Tunnel with the token above (your own domain),
# "tunnel-free" = free Quick Tunnel (random address), empty = office network only
COMPOSE_PROFILES=

# Not needed: the AI that drafts apps (Claude, Gemini or ChatGPT) and its key
# are set in the ERP, Administration -> AI. A key put here is copied there
# once, the first time the API starts; after that this line can go.
ANTHROPIC_API_KEY=

# Optional, used once: email settings that fill Administration -> Email on the
# first start (after that they're set in the app, and these can be removed).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM="Zenin ERP <you@gmail.com>"
