# Local development (`pnpm dev`) against the docker-compose db + storage.

PORT=5000

# PostgreSQL (docker-compose "db" is on localhost:5433).
# Add ?sslmode=require for hosted providers (Neon, Supabase, RDS, ...).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/generic_erp
PG_POOL_MAX=10
# log queries slower than this (ms)
SLOW_QUERY_MS=500
# above this many rows, list totals are estimated instead of counted
EXACT_COUNT_LIMIT=50000

# S3-compatible storage (docker-compose "storage" = RustFS on localhost:9000).
# Works with MinIO, AWS S3, Cloudflare R2 too.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=erp-storage
S3_SECRET_KEY=erp-storage-secret
S3_BUCKET=erp-uploads
# false for AWS S3 virtual-hosted style buckets
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_MB=50
IMPORT_MAX_MB=20
JOB_FILE_RETENTION_DAYS=14

# First admin login (only used when the database has no users yet; min 8 chars).
# Without ADMIN_PASSWORD a random password is printed to the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# Frontend origins allowed to call the API with the session cookie (comma separated)
CORS_ORIGINS=http://localhost:5173
# true when served over HTTPS
COOKIE_SECURE=false

LOG_LEVEL=info
# enables GET /metrics with "Authorization: Bearer <token>"
METRICS_TOKEN=
# run background jobs inside the API process (docker runs a separate worker)
RUN_WORKER=true

# Tests: a throwaway database whose name ends in _test (it gets wiped)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/generic_erp_test

# Optional: lets admins describe their organization in Settings -> Apps and have
# Claude draft the tables (shown in a preview first). Leave empty to hide it.
# Each draft is one request to the Anthropic API, billed to this key.
ANTHROPIC_API_KEY=
