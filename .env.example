PORT=5000

# Postgres (the docker-compose "db" service is exposed on localhost:5433)
# Add ?sslmode=require for hosted providers like Neon/Supabase/RDS.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/generic_erp

# S3-compatible object storage for uploads (the docker-compose "storage"
# service, RustFS, is exposed on localhost:9000). Works with AWS S3 / R2 too.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=erp-storage
S3_SECRET_KEY=erp-storage-secret
S3_BUCKET=erp-uploads
# set to false for AWS S3 virtual-hosted style buckets
S3_FORCE_PATH_STYLE=true

# First admin login (only used when the database has no users yet; min 8 chars).
# Without ADMIN_PASSWORD a random password is printed to the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# Frontend origins allowed to call the API with the session cookie (comma separated)
CORS_ORIGINS=http://localhost:5173
# true when served over HTTPS
COOKIE_SECURE=false
